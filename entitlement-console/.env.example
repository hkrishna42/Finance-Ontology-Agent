# ── Fabric SQL endpoint ───────────────────────────────────────────
# Warehouse > Settings > SQL endpoint > copy the SQL connection string
FABRIC_SQL_SERVER=xxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_SQL_DATABASE=wh_demo

# ── Authentication (pick ONE) ─────────────────────────────────────
# Option A (recommended for the POC): leave the three values below
#   empty and run `az login` with your own account first.
#   The app signs in as YOU (Entra ID via Azure CLI).
#
# Option B: service principal. Fill all three. The SPN must be
#   allowed in the Fabric tenant setting and added to the workspace.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

PORT=3000

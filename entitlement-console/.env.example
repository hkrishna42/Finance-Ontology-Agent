# ── Fabric SQL endpoint ───────────────────────────────────────────
# Warehouse > Settings > SQL endpoint > copy the SQL connection string
FABRIC_SQL_SERVER=xxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_SQL_DATABASE=wh_demo

# ── Authentication (pick ONE) ─────────────────────────────────────
# Option A (recommended for the POC): leave the three values below
#   empty and run `az login` with your own account first.
#   The app signs in as YOU (Entra ID via Azure CLI).
#
# Option B: service principal. Fill all three. The SPN must be
#   allowed in the Fabric tenant setting and added to the workspace.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

PORT=3000

# ── Persona verification (optional — used only by `npm run verify`) ─
# Real Entra users in your tenant, warehouse already shared with them
# (no workspace roles). P3 + P4 enable the persona matrix; P2 is optional.
VERIFY_P2_EMAIL=
VERIFY_P3_EMAIL=
VERIFY_P4_EMAIL=

# ── Database backend (optional) ───────────────────────────────────
# Auto-selected: prefers `sqlcmd` (go-sqlcmd, zero install) when present, else `odbc`.
# Force one: sqlcmd | odbc.  ODBC also needs the driver installed (see RUNBOOK.md).
# EC_DB_DRIVER=sqlcmd
# SQLCMD_BIN=sqlcmd
# ODBC_DRIVER=ODBC Driver 18 for SQL Server

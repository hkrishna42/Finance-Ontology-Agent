<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Exposure &amp; Concentration Report — {{ s.fund }}</title>
  <style>
    body { font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
           margin: 2rem; color: #1a1a1a; }
    h1 { font-size: 1.4rem; margin-bottom: 0.2rem; }
    h2 { font-size: 1.05rem; margin-top: 1.6rem; border-bottom: 1px solid #ddd; padding-bottom: 3px; }
    .meta { color: #555; font-size: 0.85rem; }
    table { border-collapse: collapse; width: 100%; margin-top: 0.5rem; font-size: 0.85rem; }
    th, td { border: 1px solid #d0d0d0; padding: 4px 8px; text-align: left; }
    th { background: #f4f4f4; }
    td.num { text-align: right; font-variant-numeric: tabular-nums; }
    .gap { color: #a11; font-weight: 600; }
    .draft { color: #888; }
    code { background: #f6f6f6; padding: 1px 4px; border-radius: 3px; font-size: 0.8rem; }
    pre { background: #f6f6f6; padding: 8px; border-radius: 4px; overflow-x: auto; font-size: 0.75rem; }
    .appendix { font-size: 0.8rem; }
    .hash { font-family: ui-monospace, monospace; font-size: 0.75rem; word-break: break-all; }
  </style>
</head>
<body>
  <h1>Exposure &amp; Concentration Report</h1>
  <div class="meta">
    <div><strong>Fund:</strong> {{ s.fund }} ({{ s.series_id }})</div>
    <div><strong>Period:</strong> {{ s.period }} &middot; <strong>As of:</strong> {{ s.as_of }}</div>
    <div><strong>Report ID:</strong> <code>{{ report_id }}</code></div>
    <div><strong>Content SHA-256:</strong> <span class="hash">{{ sha256 }}</span></div>
    <div class="draft">Generated {{ generated_at }} — deterministic; every figure is traceable to a query below.</div>
  </div>

  <h2>1. Concentration</h2>
  <p>Portfolio HHI (&Sigma; weight_pct&sup2;): <strong>{{ figures.hhi }}</strong>
     across <strong>{{ figures.n_holdings }}</strong> holdings ({{ figures.total_weight }}% total weight).</p>
  <table>
    <thead><tr><th>Supplier dependency</th><th class="num">Weighted score</th><th class="num"># holdings</th></tr></thead>
    <tbody>
    {% for r in figures.top_suppliers %}
      <tr><td>{{ r.supplier }}</td><td class="num">{{ r.score }}</td><td class="num">{{ r.n_holdings }}</td></tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>2. Risk-factor heatmap (weight mass per category)</h2>
  <table>
    <thead><tr><th>Category</th><th class="num">Weight mass</th><th class="num"># holdings</th></tr></thead>
    <tbody>
    {% for r in figures.heatmap %}
      <tr><td>{{ r.category }}</td><td class="num">{{ r.mass }}</td><td class="num">{{ r.n_holdings }}</td></tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>3. Disclosure coverage gap</h2>
  {% if figures.coverage_gap.gaps %}
  <p>Uncovered principal-risk categories:
     {% for c in figures.coverage_gap.gap_categories %}<span class="gap">{{ c }}</span>{% if not loop.last %}, {% endif %}{% endfor %}.</p>
  <table>
    <thead><tr><th>Category</th><th>Risk factor (exposed but not disclosed)</th></tr></thead>
    <tbody>
    {% for g in figures.coverage_gap.gaps %}
      <tr><td class="gap">{{ g.category }}</td><td>{{ g.title }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>No disclosure coverage gaps detected.</p>
  {% endif %}

  <h2>4. Source coverage (honesty metric)</h2>
  <p><strong>{{ figures.coverage.covered_pct }}%</strong> of fund weight is backed by an ingested source;
     <strong>{{ figures.coverage.uncovered_pct }}%</strong> is uncovered.</p>
  {% if figures.coverage.uncovered %}
  <p class="draft">Uncovered holdings: {{ figures.coverage.uncovered | join(", ") }}.</p>
  {% endif %}

  <h2>5. Single-source supplier flags</h2>
  {% if figures.single_source_flags %}
  <table>
    <thead><tr><th>Holding</th><th>Component</th><th>Sole supplier</th></tr></thead>
    <tbody>
    {% for f in figures.single_source_flags %}
      <tr><td>{{ f.holding }}</td><td>{{ f.component }}</td><td>{{ f.sole_supplier }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>No single-source flags.</p>
  {% endif %}

  <h2>Appendix A — Provenance (figure &rarr; query)</h2>
  <div class="appendix">
    {% for name, q in s.queries.items() %}
    <p><strong>{{ name }}</strong></p>
    <pre>{{ q }}</pre>
    {% endfor %}
  </div>

  <h2>Appendix B — Source spans</h2>
  <div class="appendix">
    <table>
      <thead><tr><th>Document</th><th>Chunk</th><th>Span</th></tr></thead>
      <tbody>
      {% for c in s.provenance %}
        <tr><td>{{ c.doc_id }}</td><td>{{ c.chunk_id }}</td><td>{{ c.span }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</body>
</html>
